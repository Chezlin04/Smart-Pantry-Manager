<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/recipe_card_background">

    <!-- Displays the recipe name -->
    <TextView
        android:id="@+id/tvRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scrambled Eggs"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#202124" />

    <!-- Displays how many ingredients are required -->
    <TextView
        android:id="@+id/tvIngredientCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="3 ingredients"
        android:textSize="14sp"
        android:textColor="#666666" />

    <!-- Opens the Recipe Detail screen -->
    <Button
        android:id="@+id/btnViewRecipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:text="View Recipe"
        android:textAllCaps="false" />

</LinearLayout>