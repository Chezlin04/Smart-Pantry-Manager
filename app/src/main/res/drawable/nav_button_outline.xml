<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mouse hover effect -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/nav_purple_light" />

            <stroke
                android:width="2dp"
                android:color="@color/nav_purple" />

            <corners android:radius="18dp" />

        </shape>
    </item>

    <!-- Tap/press effect -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/nav_purple_light" />

            <stroke
                android:width="2dp"
                android:color="@color/nav_purple_dark" />

            <corners android:radius="18dp" />

        </shape>
    </item>

    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="2dp"
                android:color="@color/nav_purple" />

            <corners android:radius="18dp" />

        </shape>
    </item>

</selector>