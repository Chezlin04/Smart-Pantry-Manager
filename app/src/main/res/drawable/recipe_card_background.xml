<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Purple shadow behind the recipe card -->
    <item
        android:left="4dp"
        android:top="5dp">

        <shape android:shape="rectangle">

            <solid android:color="#D8CCF4" />

            <corners android:radius="18dp" />

        </shape>

    </item>


    <!-- Main white recipe card -->
    <item
        android:right="4dp"
        android:bottom="5dp">

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <!-- Light border around the card -->
            <stroke
                android:width="1dp"
                android:color="#E5E7EB" />

            <corners android:radius="18dp" />

        </shape>

    </item>

</layer-list>